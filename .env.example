# Copy to .env and fill in. `.env` feeds both Docker Compose and Laravel: the
# application reads its configuration from container environment variables, so
# there is no second env file inside backend/.

# Host port for the review UI and the API. compose.yml binds it to 127.0.0.1.
APP_PORT=8080

APP_NAME=cv-tailor
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Structured JSON on stderr, collected by `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/cv-tailor/db/cv-tailor.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
# When the queue decides a reserved job has died and offers it to another
# worker. Keep it above the worker's `--timeout` in compose.yml, or a job that
# is merely slow is picked up twice.
DB_QUEUE_RETRY_AFTER=660

# The ceiling on one API request body, in bytes. A capture carries a page's
# whole visible text; past this the API answers 413. Keep it below PHP's
# post_max_size.
CV_MAX_BODY_BYTES=4194304

FILESYSTEM_DISK=local
# Generated PDFs. A named volume in compose.yml.
CV_PDF_ROOT=/var/lib/cv-tailor/pdfs

GOTENBERG_URL=http://gotenberg:3000

# The LLM provider. The only host this application talks to over the internet.
ANTHROPIC_API_KEY=
# One model per purpose. Per-model cost rates live in backend/config/cv.php, and
# a model with no configured rate raises rather than costing nothing.
LLM_GENERATION_MODEL=claude-opus-5
LLM_VALIDATION_MODEL=claude-haiku-4-5
LLM_EXTRACTION_MODEL=claude-haiku-4-5
# The ceiling on one response, per purpose. Raise one if a response comes back
# cut off: `docker compose logs worker | grep '"event":"generation.unusable"'`.
LLM_GENERATION_MAX_OUTPUT_TOKENS=16000
LLM_EXTRACTION_MAX_OUTPUT_TOKENS=8000

# How long a batch may stay open before the poller warns about it, and how many
# attempts a revision gets before it is failed. Batches that have been open too
# long: `docker compose logs scheduler | grep '"event":"batch.stale"'`.
CV_BATCH_STALE_AFTER_MINUTES=360
CV_BATCH_ATTEMPT_LIMIT=3

# Comma-separated proxy addresses, or * for any. Empty trusts no proxy.
TRUSTED_PROXIES=
