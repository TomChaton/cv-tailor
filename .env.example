# Copy to .env and fill in. `.env` feeds both Docker Compose and Laravel: the
# application reads its configuration from container environment variables, so
# there is no second env file inside backend/.

# Host port for the review UI and the API. compose.yml binds it to 127.0.0.1.
APP_PORT=8080

# The master CV, bind-mounted read-only into the stack. Keep it under your home
# directory: that is what a VM-backed Docker shares, and a path outside it fails
# as a missing source even when it is plainly there on the host.
MASTER_CV_HOST_PATH=${HOME}/cv-tailor/master-cv.md

APP_NAME=cv-tailor
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Structured JSON on stderr, collected by `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/cv-tailor/db/cv-tailor.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
# Generated PDFs. A named volume in compose.yml.
CV_PDF_ROOT=/var/lib/cv-tailor/pdfs

# Where MASTER_CV_HOST_PATH appears inside the containers.
MASTER_CV_PATH=/var/lib/cv-tailor/master-cv.md

GOTENBERG_URL=http://gotenberg:3000

# Comma-separated proxy addresses, or * for any. Empty trusts no proxy.
TRUSTED_PROXIES=
