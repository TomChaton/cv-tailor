{
  "name": "cv-tailor-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cv-tailor's Chrome extension: capture a job description and send it to the backend.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "api:client": "openapi-typescript openapi.json --output src/api/schema.ts",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "openapi-fetch": "^0.17.0"
  }
}
