{
    "openapi": "3.1.0",
    "info": {
        "title": "cv-tailor",
        "version": "1.0.0"
    },
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/api/v1/postings": {
            "post": {
                "operationId": "v1.postings.capture",
                "description": "Idempotent: a capture whose page text matches a posting already held\nanswers with that posting, so the extension may retry a send it never saw\nthe answer to. **A posting this capture created answers 201; one that\nalready existed answers 200.**\n\nThe response carries the posting's identity and nothing else. The\nextension has just sent the text and does not need it back.",
                "summary": "Capture a posting",
                "tags": [
                    "CapturePosting"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CapturePostingRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "status": {
                                            "$ref": "#/components/schemas/PostingStatus"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "status"
                                    ]
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "status": {
                                            "$ref": "#/components/schemas/PostingStatus"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "status"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "413": {
                        "description": "Request body larger than the limit this instance accepts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "CapturePostingRequest": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "The page the posting was captured from.",
                        "maxLength": 2048
                    },
                    "source_site": {
                        "type": "string",
                        "description": "The hostname the page was read on.",
                        "maxLength": 255
                    },
                    "page_text": {
                        "type": "string",
                        "description": "The page's visible text, whole and uninterpreted."
                    },
                    "json_ld": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "description": "The page's `JobPosting` JSON-LD object, where it published one.",
                        "additionalProperties": {}
                    },
                    "has_hidden_text": {
                        "type": "boolean",
                        "description": "Whether the page held text a reader cannot see."
                    }
                },
                "required": [
                    "url",
                    "source_site",
                    "page_text",
                    "has_hidden_text"
                ],
                "title": "CapturePostingRequest"
            },
            "PostingStatus": {
                "type": "string",
                "description": "Where a captured posting has got to. `captured \u2192 wanted \u2192 queued \u2192 ready \u2192 reviewed \u2192 applied`, plus `discarded` from anywhere. The list doubles as an application tracker, which is why the tail of it records what the owner did rather than what the pipeline did.  **`wanted` is where the owner decides to spend.** Capturing a posting is free and speculative and generating a CV for one is neither, so nothing but the owner moves a posting off `captured`.\n",
                "enum": [
                    "captured",
                    "wanted",
                    "queued",
                    "ready",
                    "reviewed",
                    "applied",
                    "discarded"
                ],
                "title": "PostingStatus"
            }
        },
        "responses": {
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}